<!doctype html>
<html lang="{{#if lang}}{{lang}}{{else}}en{{/if}}">
<head>
  {{> partials/meta}}
  <title>{{title}} | {{app_name}}</title>
  <link rel="stylesheet" href="https://www.w3schools.com/w3css/5/w3.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="w3-light-grey">
  {{> partials/navigation}}
  <main class="w3-content w3-padding page-main">
    {{{body}}}
  </main>
  <footer class="w3-container w3-dark-grey w3-center w3-padding-24">
    <small>{{app_name}} v{{version}}</small>
  </footer>
  <script src="/js/nav.js" defer></script>
  <script src="/js/load-more.js" defer></script>
</body>
</html>
