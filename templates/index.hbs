<header class="w3-container w3-white w3-card w3-margin-bottom w3-padding-32 w3-center">
  <h1 class="w3-xxlarge">Welcome to {{app_name}}</h1>
  <p class="w3-large w3-text-grey">A fast, modular web server written in Rust with Axum.</p>
  <a class="w3-button w3-blue w3-large" href="/blog">Read the blog</a>
</header>

<section aria-labelledby="latest-heading">
  <h2 id="latest-heading" class="w3-xlarge">Latest posts</h2>
  <div id="post-list">
    {{> partials/post_cards}}
  </div>
  {{#unless posts}}
  <div class="w3-panel w3-pale-yellow w3-leftbar w3-border-yellow"><p>No posts have been published yet.</p></div>
  {{/unless}}
  {{> partials/load_more}}
</section>

<section class="w3-card w3-white w3-padding w3-margin-top" aria-labelledby="api-heading">
  <h2 id="api-heading" class="w3-large">Try the API</h2>
  <ul class="w3-ul">
    <li><a href="/api/v1/hello">/api/v1/hello</a></li>
    <li><a href="/api/v1/ip">/api/v1/ip</a></li>
    <li><a href="/api/v1/health">/api/v1/health</a></li>
  </ul>
</section>
