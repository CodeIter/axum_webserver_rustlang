<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{#if description}}{{description}}{{else}}{{app_name}}: a fast, modular web server built with Rust and Axum.{{/if}}">
{{#if keywords_meta}}<meta name="keywords" content="{{keywords_meta}}">{{/if}}
{{#if meta_author}}<meta name="author" content="{{meta_author}}">{{/if}}
{{#if canonical_url}}<link rel="canonical" href="{{canonical_url}}">{{/if}}
<meta name="theme-color" content="#2196F3">
<meta property="og:title" content="{{title}}">
<meta property="og:type" content="{{#if og_type}}{{og_type}}{{else}}website{{/if}}">
{{#if description}}<meta property="og:description" content="{{description}}">{{/if}}
