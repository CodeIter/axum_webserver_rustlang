<header class="w3-container w3-white w3-card w3-margin-bottom w3-padding-16">
  <h1 class="w3-xxlarge">Blog</h1>
  <p class="w3-text-grey">{{total}} published post{{#unless (eq total 1)}}s{{/unless}}, newest first.</p>
</header>

<section aria-label="Blog posts">
  <div id="post-list">
    {{> partials/post_cards}}
  </div>
  {{#unless posts}}
  <div class="w3-panel w3-pale-yellow w3-leftbar w3-border-yellow"><p>No posts have been published yet.</p></div>
  {{/unless}}
  {{> partials/load_more}}
</section>
