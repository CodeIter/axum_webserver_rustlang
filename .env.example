# =============================================================================
# axum-server configuration
# =============================================================================
# Copy this file to `.env` and edit it:
#
#     cp .env.example .env
#
# Precedence (highest first):
#   1. Command-line flags        e.g. `axum-server --port 8000`
#   2. Environment variables     real variables win over entries in `.env`
#   3. Built-in defaults         the values shown below
#
# Every variable below is set to its built-in default, so an unmodified copy
# of this file behaves exactly like having no `.env` at all. Variables that
# have no default are commented out.
#
# Comments sit on their own lines on purpose; do not append them to a value.
# =============================================================================

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------

# IP address to bind to (CLI: --host).
# 0.0.0.0 listens on all IPv4 interfaces and is required inside Docker.
# Use 127.0.0.1 to accept local connections only. IPv6 addresses such as :: work too.
SERVER_HOST=0.0.0.0

# TCP port to listen on (CLI: --port).
# Render injects its own PORT automatically (10000 by default), but the
# Dockerfile passes `--port 8000`, which overrides this variable. When
# deploying with the Dockerfile, Render will detect the exposed port automatically.
PORT=8000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Output format for all log lines (CLI: --log-format).
#   text  human-readable, colored when attached to a terminal
#   json  one JSON object per line, best for log aggregators such as Render
LOG_FORMAT=text

# Verbosity of diagnostic logs on stderr (CLI: --log-level).
# One of: error | warn | info | debug | trace
# The access log (one line per request, on stdout) is always emitted
# regardless of this setting.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Timeouts
# -----------------------------------------------------------------------------

# Maximum seconds a request may take before the server answers
# `408 Request Timeout` (CLI: --request-timeout-secs). Must be greater than 0.
REQUEST_TIMEOUT_SECS=30

# Seconds to wait for in-flight requests to finish after a shutdown signal
# before forcing exit (CLI: --shutdown-timeout-secs).
SHUTDOWN_TIMEOUT_SECS=30

# -----------------------------------------------------------------------------
# Content directories
# -----------------------------------------------------------------------------
# Relative paths are resolved from the working directory, so run the server
# from the project root. Missing directories are created at startup, but the
# templates directory must contain the Handlebars templates or the server
# refuses to start. A missing or empty blog directory only logs a warning.

# Handlebars templates: layouts/, partials/ and page templates
# (CLI: --templates-dir).
TEMPLATES_DIR=./templates

# Markdown blog posts, `*.md` files with YAML front matter (CLI: --blog-dir).
BLOG_DIR=./blog

# Directory served at `/` as the static fallback, after template pages and
# the API have had a chance to match (CLI: --public-dir).
PUBLIC_DIR=./public

# Directory served under the STATIC_ROUTE prefix (CLI: --static-dir).
STATIC_DIR=./static

# Directory served under the RESOURCES_ROUTE prefix (CLI: --resources-dir).
RESOURCES_DIR=./resources

# URL prefix under which STATIC_DIR is served (CLI: --static-route).
STATIC_ROUTE=/static

# URL prefix under which RESOURCES_DIR is served (CLI: --resources-route).
RESOURCES_ROUTE=/resources

# -----------------------------------------------------------------------------
# Static file behaviour (applies to PUBLIC_DIR, STATIC_DIR and RESOURCES_DIR)
# -----------------------------------------------------------------------------

# File served for directory requests such as `/docs/` (CLI: --public-index-file).
# Must be a plain file name without slashes.
PUBLIC_INDEX_FILE=index.html

# What to do when a request touches a dotfile such as `/.env` or `/.git/config`
# (CLI: --public-dotfiles). The check is done on the percent-decoded path.
#   allow   serve dotfiles like any other file (not recommended)
#   deny    respond 403 Forbidden
#   ignore  respond 404 Not Found, hiding that the file exists
PUBLIC_DOTFILES=ignore

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# A fixed-window limiter keyed by client IP. IPv6 clients are grouped by their
# /64 prefix. Clients over the limit receive `429 Too Many Requests` with a
# `Retry-After` header. Both values must be greater than 0.

# Maximum requests per client per window (CLI: --rate-limit-max-requests).
RATE_LIMIT_MAX_REQUESTS=100

# Length of the rate-limit window in seconds (CLI: --rate-limit-window-secs).
RATE_LIMIT_WINDOW_SECS=60

# -----------------------------------------------------------------------------
# Concurrency
# -----------------------------------------------------------------------------

# Maximum number of requests processed at the same time
# (CLI: --max-concurrent-requests). Extra requests are not queued; they are
# rejected immediately with `503 Service Unavailable`. Must be greater than 0.
MAX_CONCURRENT_REQUESTS=1024

# -----------------------------------------------------------------------------
# Client IP detection (reverse proxies)
# -----------------------------------------------------------------------------
# The client IP is used by the rate limiter, the access log and `/api/v1/ip`.

# Trust proxy-supplied headers to find the real client IP
# (CLI: --trust-proxy-headers true|false).
# Header priority: CF-Connecting-IP > True-Client-IP > X-Forwarded-For > socket.
# Enable ONLY when the server is reachable exclusively through a trusted proxy
# (Render, Cloudflare, nginx, ...). If clients can connect directly, they can
# forge these headers and evade rate limiting.
TRUST_PROXY_HEADERS=false

# Number of proxy hops to count from the RIGHT of X-Forwarded-For to find the
# client (CLI: --xff-proxy-depth). Must be at least 1. Counting from the right
# ignores entries the client may have forged on the left.
# On Render: client, Cloudflare edge, Render load balancer => 3.
XFF_PROXY_DEPTH=1

# -----------------------------------------------------------------------------
# Public URL (used by /sitemap.xml and /robots.txt)
# -----------------------------------------------------------------------------
# The base URL is resolved from the first of these that is set:
#
#   1. PUBLIC_URL (or --public-url)
#   2. RENDER_EXTERNAL_URL        set automatically by Render
#   3. RENDER_EXTERNAL_HOSTNAME   set automatically by Render
#   4. EXTERNAL_URL
#   5. EXTERNAL_HOSTNAME
#   6. the request Host header    last resort, may be unreliable
#
# Values may be a full URL or a bare hostname. Invalid values are rejected at
# startup for PUBLIC_URL and logged as warnings for the others.

# Explicit public base URL (CLI: --public-url). Use this for a custom domain.
#PUBLIC_URL=https://example.com

# Generic fallbacks for platforms other than Render.
#EXTERNAL_URL=https://example.com
#EXTERNAL_HOSTNAME=example.com

# Set automatically on Render; listed here for completeness. Do not set these
# yourself unless you are testing Render behaviour locally.
#RENDER_EXTERNAL_URL=https://your-service.onrender.com
#RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com

# -----------------------------------------------------------------------------
# In-memory key-value store (/api/v1/kv/memory/items)
# -----------------------------------------------------------------------------

# Maximum number of entries (CLI: --memory-store-max-entries). Creating
# entries beyond this limit returns `507 Insufficient Storage`. Data is held
# in memory only and is lost on restart. Must be greater than 0.
MEMORY_STORE_MAX_ENTRIES=10000
