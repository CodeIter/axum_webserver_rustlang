# Copy to `.env`. CLI flags override these; these override built-in defaults.
SERVER_HOST=0.0.0.0
PORT=8080                       # Render injects PORT automatically
REQUEST_TIMEOUT_SECS=30
TEMPLATES_DIR=./templates
BLOG_DIR=./blog
STATIC_ROOT=./public
STATIC_INDEX_FILE=index.html
STATIC_DOTFILES=ignore          # allow | deny | ignore
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECS=60
MAX_CONCURRENT_REQUESTS=1024
SHUTDOWN_TIMEOUT_SECS=30
LOG_FORMAT=text                 # text | json
LOG_LEVEL=info                  # error | warn | info | debug | trace
TRUST_PROXY_HEADERS=true        # CF-Connecting-IP > True-Client-IP > X-Forwarded-For > socket
XFF_PROXY_DEPTH=3               # hops counted from the RIGHT of X-Forwarded-For
